# Copie este arquivo para ".env" e preencha com as credenciais reais
# do seu banco Postgres hospedado na nuvem.

PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=disable

DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=disable

# ---------------------------------------------------------------------
# Backend (API que substitui o Supabase)
# ---------------------------------------------------------------------
PORT=3001
JWT_SECRET=
CORS_ORIGIN=https://SEU-SITE.netlify.app
# PUBLIC_URL=https://api.seudominio.com

ADMIN_EMAIL=
ADMIN_PASSWORD=
